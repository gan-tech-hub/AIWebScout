{
  "manifest_version": 3,
  "name": "AI Web Scout",
  "version": "0.1.0",
  "description": "Review the current page and send it to your AI Web Scout workspace.",
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open AI Web Scout" },
  "side_panel": { "default_path": "sidepanel.html" }
}
