# Web origin used by the extension and auth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Build-time public origin for the Chrome extension
VITE_WEB_APP_URL=http://localhost:3000

# Supabase browser-safe values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets: never prefix these with NEXT_PUBLIC_ or bundle in extension
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

# Bounded agent defaults
AI_MAX_INPUT_CHARS=50000
AI_MAX_OUTPUT_TOKENS=3000
AI_MAX_TOOL_CALLS=1
AI_TIMEOUT_MS=45000

# Comma-separated extension origins allowed in production
CHROME_EXTENSION_ORIGINS=chrome-extension://replace-after-loading-unpacked
